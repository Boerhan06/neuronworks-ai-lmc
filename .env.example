# ==============================================================================
# AI Learning Management & Creator (AI-LMC) Enterprise — Environment Configuration
# Strictly adhere to Zero Data Egress: Local models only for confidential data
# ==============================================================================

# Web Frontend (Layer 1)
PORT=3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WORKER_URL=http://localhost:8000

# Backend LMS Core API Gateway (Layer 2 - Go)
API_PORT=8081
API_HOST=0.0.0.0
JWT_SECRET=super-secret-enterprise-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24

# AI Orchestrator & Media Worker (Layer 3 & 4 - Python FastAPI)
WORKER_PORT=8000
WORKER_HOST=0.0.0.0
ZERO_DATA_EGRESS=true
DEFAULT_PROVIDER=local
MAX_SCENES_PER_MODULE=5
MODULE_DURATION_SECONDS=180

# Relational Database & Vector Store (Layer 5 - PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_lmc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_lmc?sslmode=disable

# Message Broker & Cache (Layer 5 - Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (Layer 5 - MinIO S3-Compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_DOCS=internal-documents
MINIO_BUCKET_MEDIA=course-media
MINIO_BUCKET_EXPORT=scorm-exports
